// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	/*
	 * Agents
	 */
	"format_on_save": "on",
 "sticky_scroll": {
  "enabled": true
 },
 "edit_predictions": {
		"provider": "zed",
	},
	"proxy": "",
	"agent_ui_font_size": 16.0,
	"agent": {
		"dock": "left",
  "default_profile": "ask",
		"default_model": {
			"provider": "anthropic",
			"model": "claude-sonnet-4-6-latest",
			"enable_thinking": true,
			"effort": "medium",
		},
		"thinking_display": "always_collapsed",
		"max_content_width": 650.0,
		"default_width": 250.0,
		"favorite_models": [],
		"model_parameters": [],
	},
	"agent_servers": {
		"claude-acp": {
			"type": "registry",
		},
	},

	/*
	 * Fonts
	 */
	"ui_font_size": 16.0,
	"ui_font_weight": 400.0,
	"ui_font_family": ".ZedSans",

	"buffer_font_size": 16,
	"buffer_font_weight": 400.0,
	"buffer_font_family": "JetBrainsMono Nerd Font",
	"buffer_line_height": "comfortable",

	/*
	 * Editor
	 */
	"text_rendering_mode": "platform_default",
	"cursor_shape": "bar",
	"cursor_blink": true,
	"hard_tabs": true,
	"show_edit_predictions": true,
	"show_wrap_guides": true,
	"colorize_brackets": true,
	"indent_guides": {
		"enabled": true,
		"coloring": "indent_aware",
	},
	"file_finder": {
		"modal_max_width": "small",
	},
	"show_whitespaces": "selection",
	"soft_wrap": "editor_width",

	/*
	 * Layout, Buttons, Tabs etc.
	 */

	"git": {
		"inline_blame": {
			"enabled": true,
			"show_commit_summary": true,
		},
	},
	"gutter": {
		"breakpoints": true,
		"min_line_number_digits": 0,
	},
	"scrollbar": {
		"show": "auto",
	},
	"toolbar": {
		"agent_review": false,
		"selections_menu": false,
		"quick_actions": false,
		"breadcrumbs": false,
	},
	"title_bar": {
		"show_user_menu": true,
		"button_layout": "platform_default",
		"show_menus": false,
		"show_user_picture": true,
		"show_branch_status_icon": true,
	},
	"status_bar": {
		"active_language_button": true,
		"show_active_file": false,
		"cursor_position_button": false,
	},
	"preview_tabs": {
		"enable_preview_multibuffer_from_code_navigation": false,
		"enable_keep_preview_on_code_navigation": false,
		"enable_preview_from_file_finder": false,
		"enable_preview_from_project_panel": true,
		"enabled": true,
	},
	"tabs": {
		"file_icons": true,
		"git_status": true,
		"close_position": "right",
		"show_diagnostics": "errors",
	},
	"tab_bar": {
		"show": true,
		"show_pinned_tabs_in_separate_row": false,
		"show_tab_bar_buttons": true,
		"show_nav_history_buttons": true,
	},
	"debugger": {
		"button": false,
	},
	"search": {
		"button": true,
	},
	"diagnostics": {
		"button": true,
		"inline": {
			"enabled": true,
		},
	},

	/*
	 * Panels
	 */
	"collaboration_panel": {
		"dock": "right",
  "button": false,
	},
	"git_panel": {
		"dock": "right",
  "button": true,
	},
	"outline_panel": {
		"dock": "right",
  "button": false,
	},

	"project_panel": {
		"dock": "right",
		"default_width": 240.0,
		"indent_size": 16.0,
		"git_status": true,
		"git_status_indicator": true,
		"diagnostic_badges": true,
		"sort_mode": "directories_first",
		"entry_spacing": "comfortable",
		"hide_hidden": false,
		"hide_root": false,
		"hide_gitignore": false,
		"auto_reveal_entries": true,
		"starts_open": true,
	},

	/*
	 * Terminal
	 */
	"terminal": {
		"minimum_contrast": 50.0,
		"toolbar": {
			"breadcrumbs": false,
		},
		"font_weight": 400.0,
		"font_size": 14.0,
	},

	/*
	 * Theming & Keymaps
	 */
	"base_keymap": "VSCode",
	"icon_theme": {
  "mode": "light",
  "light": "Material Icon Theme",
  "dark": "Colored Zed Icons Theme Dark"
 },
	"theme": {
  "mode": "system",
  "light": "One Light",
  "dark": "Catppuccin Mocha - No Italics"
 },

	"experimental.theme_overrides": {
		"border.variant": "#90A4AE66",

		// 	"syntax": {
		// 		"string": {
		// 			"color": "#C9C25FFF",
		// 		},
		// 		"function": {
		// 			"color": "#A7B4C2FF",
		// 		},
		// 		"property": {
		// 			"color": "#E3C0A1FF",
		// 		},
		// 		"variable": {
		// 			"color": "#E8D5ACFF",
		// 		},
		// 		"tag": {
		// 			"color": "#F5A39FFF",
		// 		},
		// 	},
	},

	/*
	 * Others
	 */

	"languages": {
		"JavaScript": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true,
			},
		},
		"TypeScript": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true,
			},
		},
		"JSONC": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true,
			},
		},
		"JSON": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true,
			},
		},
	},

	"lsp": {
		"biome": {
			"settings": {
				"config_path": "<path>/biome.json",
				"require_config_file": true,
				},
			},
	},
	"session": {
		"trust_all_worktrees": true,
	},
	"prettier": {
		"allowed": true,
	},
	"telemetry": {
		"diagnostics": true,
		"metrics": false,
	},
	"file_scan_exclusions": [
		"**/.git",
		"**/node_modules",
		"**/target",
		"**/.next",
		"**/dist",
	],
}
